{
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/run.py"
    },
    {
      "source": "/health",
      "destination": "/run.py"
    }
  ]
}